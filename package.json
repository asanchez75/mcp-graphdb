{
  "name": "mcp-server-graphdb",
  "version": "0.1.2",
  "description": "MCP server for interacting with Ontotext GraphDB via SPARQL",
  "license": "MIT",
  "type": "module",
  "author": "keonchennl",
  "repository": {
    "type": "git",
    "url": "https://github.com/keonchennl/mcp-server-graphdb.git"
  },
  "bugs": {
    "url": "https://github.com/keonchennl/mcp-server-graphdb/issues"
  },
  "homepage": "https://github.com/keonchennl/mcp-server-graphdb#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "graphdb",
    "sparql",
    "rdf",
    "semantic-web",
    "ontotext",
    "knowledge-graph",
    "llm"
  ],
  "bin": {
    "mcp-server-graphdb": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"if (process.platform !== 'win32') require('child_process').execSync('chmod +x dist/index.js')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.1",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/node-fetch": "^2.6.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "smithery": {
    "mcpServer": true,
    "entry": "./dist/index.js"
  }
}
